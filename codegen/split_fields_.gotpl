{{ define "split_fields_.gotpl" }}
{{ reserveImport "fmt" }}
{{- /* Per-object resolve adapter: one __resolveField_<T> per (object, shard).
       A single switch over the field index (position in object.Fields) replaces
       the per-field Resolve closures. Each case mirrors the body emitted by the
       FieldDef branch of split_register_.gotpl (InvokeResolver for resolver/
       non-obj-receiver fields, otherwise splitFieldAccess). Emitted into the
       shard file in the same package as register.generated.go so Task 3 can
       point FieldDef.Resolve at it. Stream objects resolve via StreamFieldDef
       (Task 6) and are skipped here. */}}
{{- range $object := .Objects }}
{{- if $object.Stream }}{{ continue }}{{ end }}
func __resolveField_{{ $object.Name }}(ctx context.Context, ec shardruntime.ObjectExecutionContext, fieldIdx uint16, obj any) (any, error) {
	switch fieldIdx {
	{{- range $i, $field := $object.Fields }}
	case {{ $i }}:
		{{- if or $field.IsResolver (ne $field.GoReceiverName "obj") }}
		return ec.InvokeResolver(ctx, {{ $object.Name | quote }}, {{ $field.Name | quote }}, obj)
		{{- else }}
		{{- template "splitFieldAccess" $field }}
		{{- end }}
	{{- end }}
	default:
		return nil, fmt.Errorf("unknown field index %d for {{ $object.Name }}", fieldIdx)
	}
}
{{ end }}
{{ end }}
{{ define "splitFieldAccess" }}
	{{- if .IsMap }}
			switch v := obj.({{ .Object.Reference | ref }})[{{ .Name | quote }}].(type) {
			case {{ if .Stream }}<-chan {{ end }}{{ .TypeReference.GO | ref }}:
				return v, nil
			case {{ if .Stream }}<-chan {{ end }}{{ .TypeReference.Elem.GO | ref }}:
				return &v, nil
			case nil:
				return ({{ .TypeReference.GO | ref }})(nil), nil
			default:
				return nil, fmt.Errorf("unexpected type %T for field %s", v, {{ .Name | quote }})
			}
	{{- else if .IsMethod }}
			{{- if gt (len .Args) 0 }}
			fc := graphql.GetFieldContext(ctx)
			{{- end }}
			{{- if .HasHaser }}
			if !obj.({{ .Object.Reference | ref }}).{{ .HaserMethodName }}() {
				return nil, nil
			}
			{{- end }}
			{{- if .VOkFunc }}
			v, ok := obj.({{ .Object.Reference | ref }}).{{ .GoFieldName }}({{ .CallArgs }})
			if !ok {
				return nil, nil
			}
			return v, nil
			{{- else if .NoErr }}
			return obj.({{ .Object.Reference | ref }}).{{ .GoFieldName }}({{ .CallArgs }}), nil
			{{- else }}
			return obj.({{ .Object.Reference | ref }}).{{ .GoFieldName }}({{ .CallArgs }})
			{{- end }}
	{{- else if .IsVariable }}
			{{- if .HasHaser }}
			if !obj.({{ .Object.Reference | ref }}).{{ .HaserMethodName }}() {
				return nil, nil
			}
			{{- end }}
			return obj.({{ .Object.Reference | ref }}).{{ .GoFieldName }}, nil
	{{- end }}
{{- end }}
